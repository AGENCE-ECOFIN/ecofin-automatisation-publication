# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ecofin_pub
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=ecofin_pub

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Blotato API (Plateforme de publication centralisée - 3 réseaux: LinkedIn, X, Facebook)
# Récupérez votre clé API depuis: https://blotato.com/settings/api
BLOTATO_API_KEY=your-blotato-api-key

# IDs des comptes Blotato pour les 3 réseaux
# Pour trouver vos IDs de compte:
# 1. Connectez vos réseaux sociaux dans Blotato
# 2. Utilisez: curl -H "blotato-api-key: YOUR_KEY" https://backend.blotato.com/v2/accounts
BLOTATO_LINKEDIN_ACCOUNT_ID=your-linkedin-account-id
BLOTATO_X_ACCOUNT_ID=your-x-account-id
BLOTATO_FACEBOOK_ACCOUNT_ID=your-facebook-account-id

# Social Media APIs (Legacy - non nécessaire avec Blotato)
# Ces configurations ne sont plus utilisées si vous utilisez Blotato
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# SMTP Configuration (pour l'envoi d'emails)
SMTP_HOST=sequencemedia.smtp.com
SMTP_PORT=587
SMTP_USER=n8n_mediamania
SMTP_PASSWORD=W44MptRw9ww63C
SMTP_FROM_EMAIL=n8n_mediamania@sequencemedia.smtp.com
SMTP_FROM_NAME=EcoFin Publication

# Application
APP_NAME=EcoFin Publication
FRONTEND_URL=http://localhost:3000

# MinIO Configuration pour le stockage des images des posts directs
# MinIO fournit des URLs publiques accessibles par Blotato
MINIO_ENDPOINT=185.143.103.162:9000
MINIO_ACCESS_KEY=publication
MINIO_SECRET_KEY=itX3ADweDBgxKbabbcHqZmNZCsNHHMtZ
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://185.143.103.162:9000

